{
  "name": "herune",
  "version": "0.1.0-alpha.0",
  "description": "Standalone desktop client for existing Hermes agents.",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "apps/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/desktop",
    "build": "npm run build --workspace apps/desktop",
    "pack": "npm run pack --workspace apps/desktop",
    "dist": "npm run dist --workspace apps/desktop",
    "typecheck": "npm run typecheck --workspace apps/desktop && npm run typecheck --workspace apps/shared",
    "test": "npm run test --workspace apps/desktop",
    "test:external": "npm run test:external --workspace apps/desktop",
    "test:ui": "npm run test:ui --workspace apps/desktop",
    "test:electron": "npm run test:desktop:platforms --workspace apps/desktop",
    "check": "npm run typecheck && npm run test && npm run lint --workspaces",
    "fix": "npm run fix --workspaces",
    "dev:rune": "cargo run --manifest-path apps/rune/Cargo.toml --",
    "test:rune": "cargo test --manifest-path apps/rune/Cargo.toml",
    "build:rune": "cargo build --manifest-path apps/rune/Cargo.toml --release",
    "test:rune:ui": "node apps/rune/scripts/check-scenes.mjs",
    "test:rune:composer": "node apps/rune/scripts/check-composer.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nggurbanov/herune.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nggurbanov/herune/issues"
  },
  "homepage": "https://github.com/nggurbanov/herune#readme",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "10.12.0",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "@electron/osx-sign": {
      "isbinaryfile": "5.0.7"
    },
    "lodash": "4.18.1",
    "protobufjs": "^8.7.1",
    "brace-expansion": "5.0.12",
    "mermaid": "11.17.2",
    "dompurify": "3.4.17",
    "katex": "0.19.0",
    "ip-address": "10.7.4",
    "nanoid@^3": "3.3.20",
    "nanoid@^6": "6.0.2",
    "js-yaml@^4": "4.3.2",
    "undici@^6": "6.29.0",
    "undici@^7": "7.30.0",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6",
    "tar": "7.5.22",
    "source-map-js": "1.2.2",
    "yaml": "2.9.1",
    "vitest": "4.1.12",
    "@vitest/mocker": "4.1.12"
  },
  "engines": {
    "node": ">=26",
    "npm": "<11.10.0 || >=11.17.0"
  },
  "allowScripts": {
    "unicode-animations": false,
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true,
    "get-windows@9.3.0": true
  },
  "dependencies": {
    "js-yaml": "4.3.2",
    "semver": "7.7.4"
  }
}
