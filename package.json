{
  "name": "herune",
  "version": "0.1.0-alpha.0",
  "description": "Standalone desktop client for existing Hermes agents.",
  "private": true,
  "workspaces": [
    "apps/shared",
    "packages/plugin-sdk",
    "packages/builtin-bots",
    "packages/native-plugin-host"
  ],
  "scripts": {
    "dev": "node scripts/build/native.mjs dev",
    "build": "node scripts/build/native.mjs build",
    "pack": "node scripts/build/native.mjs pack",
    "dist": "node scripts/build/native.mjs dist",
    "build:sdk": "node apps/rune/scripts/build-plugin-host.mjs",
    "typecheck": "npm run typecheck --workspace apps/shared && tsc -p packages/plugin-sdk/tsconfig.json --noEmit && tsc -p packages/builtin-bots/tsconfig.json",
    "test": "npm run test --workspace packages/plugin-sdk && npm run test --workspace packages/builtin-bots && npm run test --workspace packages/native-plugin-host && node --test apps/rune/scripts/package-recipes.test.mjs",
    "test:rune": "cargo +1.95.0 test --locked --manifest-path apps/rune/Cargo.toml",
    "dev:rune": "npm run dev",
    "build:rune": "npm run build",
    "test:rune:ui": "node apps/rune/scripts/check-scenes.mjs",
    "test:rune:composer": "node apps/rune/scripts/check-composer.mjs",
    "check": "npm run typecheck && npm test && npm run test:rune",
    "pretypecheck": "npm run build:sdk",
    "pretest": "npm run build:sdk",
    "pretest:rune": "npm run build:sdk"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nggurbanov/herune.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nggurbanov/herune/issues"
  },
  "homepage": "https://github.com/nggurbanov/herune#readme",
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "playwright": "1.56.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "overrides": {
    "lodash": "4.18.1",
    "protobufjs": "^8.7.1",
    "brace-expansion": "5.0.12",
    "mermaid": "11.17.2",
    "dompurify": "3.4.17",
    "katex": "0.19.0",
    "ip-address": "10.7.4",
    "nanoid@^3": "3.3.20",
    "nanoid@^6": "6.0.2",
    "js-yaml@^4": "4.3.2",
    "undici@^6": "6.29.0",
    "undici@^7": "7.30.0",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6",
    "tar": "7.5.22",
    "source-map-js": "1.2.2",
    "yaml": "2.9.1",
    "vitest": "4.1.12",
    "@vitest/mocker": "4.1.12"
  },
  "engines": {
    "node": ">=26",
    "npm": "<11.10.0 || >=11.17.0"
  },
  "allowScripts": {
    "unicode-animations": false,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@nanostores/react": "1.1.0",
    "@tanstack/react-query": "5.104.1",
    "nanostores": "1.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "tailwindcss": "4.3.3"
  }
}
